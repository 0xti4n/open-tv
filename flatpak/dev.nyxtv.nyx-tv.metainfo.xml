  <name>Nyx TV</name>
  <summary>Fast and powerful IPTV app</summary>
  <content_rating type="oars-1.1" />
  <branding>
    <color type="primary" scheme_preference="light">#7a00d9</color>
    <color type="primary" scheme_preference="dark">#7a00d9</color>
  </branding>
  <description>
    <p>Nyx TV is an IPTV desktop application that plays video in mpv.</p>
    <p>Features:</p>
    <ul>
      <li>Import channels from M3U files, M3U links, and Xtream sources</li>
      <li>Record while watching</li>
      <li>Manage multiple IPTV sources and favorites</li>
      <li>Navigate with a TV remote or keyboard</li>
      <li>Create and share custom channels</li>
    </ul>
  </description>
  <categories>
    <category>AudioVideo</category>
    <category>Video</category>
  </categories>
  <launchable type="desktop-id">dev.nyxtv.nyx-tv.desktop</launchable>
